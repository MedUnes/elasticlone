# --- Source Elasticsearch Cluster ---
# Hostname or IP address of the source cluster
SOURCE_HOST=localhost
# Port number for the source cluster (e.g., 9200)
SOURCE_PORT=9200
# Optional: Username for source cluster authentication (leave blank for no auth)
SOURCE_USER=elastic
# Optional: Password for source cluster authentication (leave blank for no auth)
SOURCE_PASS=changeme

# --- Target Elasticsearch Cluster ---
# Hostname or IP address of the target cluster
TARGET_HOST=localhost
# Port number for the target cluster (e.g., 9201)
TARGET_PORT=9201
# Optional: Username for target cluster authentication (leave blank for no auth)
TARGET_USER=elastic
# Optional: Password for target cluster authentication (leave blank for no auth)
TARGET_PASS=changeme

# --- Cloning Parameters ---
# Index name or pattern to clone (e.g., my-index, my-index-*)
INDEX_NAME=my-index
# Optional: Number of documents to fetch per scroll request
BATCH_SIZE=1000
# Optional: Number of concurrent workers for indexing data into the target
WORKERS=4

# --- Security ---
# Optional: Set to "false" to disable SSL/TLS certificate verification (use with caution)
SSL_VERIFY=true

# --- Advanced ---
# Optional: Specify the scroll duration (e.g., 1m, 5m)
# SCROLL_DURATION=1m
# Optional: Max retries for Elasticsearch operations
# MAX_RETRIES=3
