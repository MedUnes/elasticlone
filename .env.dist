# --- Source Elasticsearch Cluster ---
# Hostname or IP address of the source cluster (Required)
SOURCE_HOST=localhost
# Port number for the source cluster (e.g., 9200) (Required)
SOURCE_PORT=9200
# Optional: Username for source cluster authentication (leave blank for no auth)
SOURCE_USER=elastic
# Optional: Password for source cluster authentication (leave blank for no auth)
SOURCE_PASS=changeme

# --- Target Elasticsearch Cluster (Optional - Defaults to Source if Blank) ---
# Optional: Hostname or IP address of the target cluster. Defaults to SOURCE_HOST if empty.
TARGET_HOST=
# Optional: Port number for the target cluster. Defaults to SOURCE_PORT if empty.
TARGET_PORT=
# Optional: Username for target cluster authentication. Defaults to SOURCE_USER if empty.
TARGET_USER=
# Optional: Password for target cluster authentication. Defaults to SOURCE_PASS if empty.
TARGET_PASS=

# --- Cloning Parameters ---
# Index name or pattern on the source cluster (Required)
INDEX_NAME=my-index
# Optional: Name for the index on the target cluster. Defaults to the source index name.
# NOTE: This can only be used if INDEX_NAME resolves to a SINGLE source index (no wildcards matching multiple).
TARGET_INDEX_NAME=
# Optional: Number of documents to fetch per scroll request
BATCH_SIZE=1000
# Optional: Number of concurrent workers for indexing data into the target
WORKERS=4

# --- Security ---
# Optional: Set to "false" to disable SSL/TLS certificate verification (use with caution)
# This setting applies to BOTH source and target connections if used.
SSL_VERIFY=true

# --- Advanced ---
# Optional: Specify the scroll duration (e.g., 1m, 5m)
# SCROLL_DURATION=1m
# Optional: Max retries for Elasticsearch operations
# MAX_RETRIES=3